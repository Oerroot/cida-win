<Window x:Class="Cida.Desktop.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="辞达 · 设置" Width="620" Height="740" MinWidth="540" MinHeight="440" WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="设置" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,22"/>
        <TabControl x:Name="Pages" Grid.Row="1">
            <TabItem Header="模型">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,12">
                    <TextBlock Text="模型服务" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ModelSummary" Foreground="{DynamicResource InkSecondary}" FontSize="13" Margin="0,8,0,16" TextWrapping="Wrap"/>
                    <TextBlock Text="使用你自己的模型服务。所有处理请求直接发送到下面的端点。" Foreground="{DynamicResource InkSecondary}" FontSize="13" TextWrapping="Wrap"/>
                    <Button Content="复制 AI 配置说明" Click="OnCopyConfiguration" HorizontalAlignment="Left" Foreground="{DynamicResource Accent}" Margin="0,10,0,8"/>
                    <TextBlock Text="配置说明会带上当前配置与最近一次失败类别；不包含 API Key、原文或输出。" Foreground="{DynamicResource InkSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <Expander Header="手工配置" IsExpanded="True">
                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="完整端点地址" Margin="0,0,0,6"/><TextBox x:Name="Endpoint" AutomationProperties.Name="完整端点地址"/>
                            <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="协议" Margin="0,0,0,6"/><ComboBox x:Name="Format" DisplayMemberPath="Title" SelectedValuePath="Value"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="模型名称" Margin="0,0,0,6"/><TextBox x:Name="ModelName"/></StackPanel>
                            </Grid>
                            <TextBlock Text="API Key" Margin="0,16,0,6"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="166"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="KeyMode" SelectionChanged="OnKeyMode"><ComboBoxItem Content="保留已存密钥"/><ComboBoxItem Content="更换密钥"/><ComboBoxItem Content="清除密钥"/></ComboBox>
                                <PasswordBox x:Name="ApiKey" Grid.Column="2" IsEnabled="False" AutomationProperties.Name="新 API Key"/>
                            </Grid>
                            <TextBlock Text="密钥由 Windows 加密保存在当前用户下，导出配置不包含密钥。" Foreground="{DynamicResource InkSecondary}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <Expander Header="高级请求配置" Margin="0,18,0,0"><StackPanel Margin="0,12,0,0">
                                <TextBlock Text="认证方式" Margin="0,0,0,6"/><ComboBox x:Name="Authentication"/>
                                <TextBlock Text="额外请求头 · JSON" Margin="0,14,0,6"/><TextBox x:Name="Headers" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="130" VerticalScrollBarVisibility="Auto"/>
                                <TextBlock Text="额外请求体 · JSON" Margin="0,14,0,6"/><TextBox x:Name="Body" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="130" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel></Expander>
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button x:Name="CheckButton" Content="测试连接" Click="OnCheck" BorderThickness="1"/><Button x:Name="CancelCheck" Content="取消测试" Click="OnCancelCheck" Visibility="Collapsed"/></StackPanel>
                            <TextBlock x:Name="CheckStatus" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource InkSecondary}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Expander>
                    <TextBlock Text="语言" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,14"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="我的语言" Margin="0,0,0,6"/><TextBox x:Name="MyLanguage"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="常用外语" Margin="0,0,0,6"/><TextBox x:Name="ForeignLanguage"/></StackPanel>
                    </Grid>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="动作">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,12">
                    <TextBlock Text="选择文字后，执行第一个启用的动作；不修改提示词也可以直接用固定样例试运行。" Foreground="{DynamicResource InkSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <ListBox x:Name="ActionsList" Height="140" DisplayMemberPath="Name" SelectionChanged="OnActionSelection" Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource PanelBorder}" Padding="4">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/></Style></ListBox.ItemContainerStyle>
                    </ListBox>
                    <StackPanel x:Name="ActionListButtons" Orientation="Horizontal" Margin="0,8,0,20"><Button Content="新增" Click="OnAddAction"/><Button Content="上移" Click="OnMoveUp"/><Button Content="下移" Click="OnMoveDown"/><Button x:Name="DeleteAction" Content="删除" Click="OnDeleteAction"/></StackPanel>
                    <TextBlock Text="名称" Margin="0,0,0,6"/><TextBox x:Name="ActionName" TextChanged="OnActionEdited" AutomationProperties.Name="动作名称"/>
                    <CheckBox x:Name="ActionEnabled" Content="在面板中显示" Margin="0,12,0,16" Checked="OnActionToggled" Unchecked="OnActionToggled"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ActionPromptTitle" Text="提示词 · 已保存" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="DiscardAction" Content="放弃修改" Click="OnDiscardAction" Margin="0,0,8,0" Visibility="Collapsed"/>
                            <Button x:Name="ResetPrompt" Content="恢复内置提示词" Click="OnResetPrompt" Margin="0"/>
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="ActionPrompt" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="170" VerticalScrollBarVisibility="Auto" TextChanged="OnActionEdited" AutomationProperties.Name="动作提示词"/>
                    <TextBlock x:Name="ActionEditHint" Foreground="{DynamicResource InkSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0" VerticalAlignment="Center">
                        <Button x:Name="PreviewButton" Content="试运行" Click="OnPreview" BorderThickness="1"/>
                        <Button x:Name="CancelPreview" Content="停止" Click="OnCancelPreview" Visibility="Collapsed"/>
                        <Button x:Name="ModelSettingsButton" Content="模型设置" Click="OnModelSettings" Foreground="{DynamicResource Accent}" Visibility="Collapsed"/>
                        <TextBlock x:Name="PreviewKeyHint" Text="Ctrl+Enter" FontSize="12" Foreground="{DynamicResource InkHint}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="固定样本：This sentence need to be more clear and natural." FontSize="12" Foreground="{DynamicResource InkSecondary}" Margin="0,12,0,8" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PreviewStatus" FontSize="13" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock x:Name="PreviewFailure" FontSize="13" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
                    <TextBox x:Name="PreviewResult" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="200" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" AutomationProperties.Name="试运行结果"/>
                    <TextBlock x:Name="PreviewReferenceLabel" FontSize="12" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap" Margin="0,12,0,6" Visibility="Collapsed"/>
                    <TextBox x:Name="PreviewReference" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Foreground="{DynamicResource InkSecondary}" MinHeight="70" MaxHeight="160" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" AutomationProperties.Name="参照结果"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="快捷键">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,12">
                    <TextBlock Text="点一下组合键框，直接按下新的组合；Backspace 清除。" FontSize="13" Foreground="{DynamicResource InkSecondary}" Margin="0,0,0,16" TextWrapping="Wrap"/>
                    <Grid x:Name="ShortcutRows"/>
                    <TextBlock x:Name="ShortcutStatus" FontSize="13" Foreground="{DynamicResource Error}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                    <Button Content="恢复默认快捷键" Click="OnResetShortcuts" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                    <TextBlock Text="在 Windows 上如何工作" FontSize="18" FontWeight="SemiBold" Margin="0,30,0,10"/>
                    <TextBlock x:Name="ShortcutCapabilities" FontSize="13" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap"/>
                    <TextBlock Text="面板内" FontSize="18" FontWeight="SemiBold" Margin="0,30,0,14"/>
                    <TextBlock x:Name="PanelKeys" Text="Enter 执行　Shift+Enter 换行&#10;Tab 切换动作　Esc 隐藏&#10;Ctrl+. 停止　Ctrl+L 修改常用外语&#10;Ctrl+C 复制　Ctrl+Shift+C 复制图片&#10;Ctrl+, 打开设置" FontSize="14" TextBlock.LineHeight="30" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="通用">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,12">
                    <CheckBox x:Name="LaunchAtLogin" Content="登录 Windows 时启动辞达"/>
                    <Separator Margin="0,22,0,22" Background="{DynamicResource PanelBorder}"/>
                    <TextBlock Text="更新" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="UpdateStatus" FontSize="13" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap" Margin="0,10,0,8"/>
                    <TextBlock x:Name="UpdateNotes" FontSize="13" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
                    <TextBlock x:Name="UpdateHint" FontSize="12" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
                    <ProgressBar x:Name="UpdateProgress" Height="6" MinHeight="6" Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource Accent}" Background="{DynamicResource AccentSoft}" BorderThickness="0" Margin="0,0,0,10" Visibility="Collapsed"/>
                    <TextBlock x:Name="UpdateDeferredNote" FontSize="13" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" Text="已下载更新。离开设置页后不会自动重启；可以在这里安装，或从托盘菜单安装。"/>
                    <WrapPanel>
                        <Button x:Name="CheckUpdate" Content="检查更新" Click="OnUpdateCheck" BorderThickness="1"/>
                        <Button x:Name="DownloadUpdate" Content="安装并重启" Style="{StaticResource PrimaryButton}" Click="OnInstallUpdate" Visibility="Collapsed"/>
                        <Button x:Name="RestartUpdate" Content="安装并重启" Style="{StaticResource PrimaryButton}" Click="OnInstallUpdate" Visibility="Collapsed"/>
                        <Button x:Name="UpdateLater" Content="稍后" Click="OnUpdateLater" Visibility="Collapsed"/>
                        <Button x:Name="SkipUpdate" Content="跳过这个版本" Foreground="{DynamicResource InkSecondary}" BorderThickness="0" Background="Transparent" Click="OnSkipUpdate" Visibility="Collapsed"/>
                        <Button x:Name="CancelDownload" Content="取消下载" Click="OnCancelDownload" Visibility="Collapsed"/>
                        <Button x:Name="OpenReleases" Content="打开下载页" Click="OnReleases"/>
                    </WrapPanel>
                    <Separator Margin="0,22,0,22" Background="{DynamicResource PanelBorder}"/>
                    <TextBlock Text="本地能力" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="Capabilities" Foreground="{DynamicResource InkSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,14"/>
                    <WrapPanel><Button Content="刷新能力" Click="OnCapabilities" BorderThickness="1"/><Button Content="打开配置目录" Click="OnOpenDirectory"/><Button Content="恢复配置备份" Click="OnRestoreBackup"/><Button Content="导出配置" Click="OnExport"/></WrapPanel>
                    <Separator Margin="0,22,0,22" Background="{DynamicResource PanelBorder}"/>
                    <TextBlock Text="辞达而已矣。" FontFamily="{DynamicResource ReadingFont}" FontSize="23"/>
                    <TextBlock Text="基于 Xuanwo/Cida · Windows 版&#10;系统浅深色 · 不保存翻译历史" FontSize="13" Foreground="{DynamicResource InkSecondary}" Margin="0,10,0,14" TextWrapping="Wrap"/>
                    <WrapPanel><Button Content="反馈问题" Click="OnFeedback"/><Button Content="原项目" Click="OnUpstream"/></WrapPanel>
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="2" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock x:Name="VersionLabel" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource InkSecondary}"/><TextBlock x:Name="SaveStatus" TextWrapping="Wrap" MaxWidth="330" FontSize="12" Foreground="{DynamicResource Error}" Margin="0,6,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="取消" Click="OnCancel" Margin="0,0,8,0"/><Button Content="保存" Style="{StaticResource PrimaryButton}" Click="OnSave"/></StackPanel>
        </Grid>
    </Grid>
</Window>
