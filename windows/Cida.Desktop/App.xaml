<Application x:Class="Cida.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#F8F7F4" />
        <SolidColorBrush x:Key="PanelBorder" Color="#E3E0D8" />
        <SolidColorBrush x:Key="Ink" Color="#1F1D1A" />
        <SolidColorBrush x:Key="InkSecondary" Color="#6E6A62" />
        <SolidColorBrush x:Key="Accent" Color="#B4552D" />
    </Application.Resources>
</Application>
