<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Cida.Core\Cida.Core.csproj" />
    <ProjectReference Include="..\Cida.Platform\Cida.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <StartupObject>Cida.Desktop.Program</StartupObject>
    <AssemblyName>Cida</AssemblyName>
    <RootNamespace>Cida.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <Version>0.2.0-rc.1</Version>
    <ApplicationIcon>Assets\Brand\Cida.ico</ApplicationIcon>
  </PropertyGroup>


  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf;Assets\Brand\Cida.png;Assets\Brand\Cida.ico" />
    <Content Include="Assets\Fonts\OFL-*.txt;Assets\provenance.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
