<Window x:Class="Cida.Desktop.PanelWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="辞达" Width="800" Height="620" MinWidth="340" MinHeight="300" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Background="{DynamicResource PanelBackground}">
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
    <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1.0*"/><RowDefinition Height="Auto"/><RowDefinition Height="1.6*"/></Grid.RowDefinitions>
            <Border x:Name="CaptionBar" Background="Transparent" Padding="28,18,20,0" SizeChanged="OnCaptionSizeChanged">
            <Grid Background="Transparent" x:Name="TitleBar">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image x:Name="BrandIcon" Width="24" Height="24" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="辞达" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="SettingsButton" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnSettings" ToolTip="设置 · Ctrl+," AutomationProperties.Name="设置"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE713;" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="设置"/></StackPanel></Button><Button x:Name="HideButton" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnHide" ToolTip="隐藏面板 · Esc" AutomationProperties.Name="关闭" Margin="0"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8BB;" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="关闭"/></StackPanel></Button></StackPanel>
            </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="28,16,28,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,12"><TextBlock Text="原文" FontSize="12" Foreground="{DynamicResource InkSecondary}"/><TextBlock x:Name="SourceCount" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource InkSecondary}"/></Grid>
                <Grid Grid.Row="1">
                    <TextBox x:Name="Composer" BorderThickness="0" Padding="0" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" FontSize="16" TextBlock.LineHeight="27" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextChanged="OnSourceChanged" AutomationProperties.Name="原文"/>
                    <TextBlock x:Name="ComposerHint" Text="粘贴文字，或用 Alt+A 带入选区" FontSize="16" Foreground="{DynamicResource InkSecondary}" IsHitTestVisible="False" TextWrapping="Wrap"/>
                </Grid>
            </Grid>
            <Border Grid.Row="2" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,1" Padding="20,10">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="ActionButtons" Orientation="Horizontal"/></ScrollViewer>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"><Button x:Name="StopButton" Content="停止" Click="OnStop" Visibility="Collapsed" ToolTip="停止 · Ctrl+."/><Button x:Name="ExecuteButton" Content="执行 ↵" Click="OnExecute" Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="0"/></StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="3" Background="{DynamicResource Paper}" CornerRadius="0,0,14,14">
                <Grid Margin="28,18,28,22">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="ResultTitle" Text="译文" FontSize="12" Foreground="{DynamicResource InkSecondary}"/><TextBlock x:Name="PhaseLabel" Margin="12,0,0,0" FontSize="12" Foreground="{DynamicResource InkSecondary}"/></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="CopyButton" Content="复制" Click="OnCopy" ToolTip="复制 · Ctrl+C" IsEnabled="False"/><Button x:Name="ImageButton" Content="复制图片" Click="OnCopyImage" ToolTip="复制图片 · Ctrl+Shift+C" IsEnabled="False" Margin="0"/></StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <RichTextBox x:Name="ResultView" IsReadOnly="True" IsReadOnlyCaretVisible="False" BorderThickness="0" Padding="0" Background="Transparent" Foreground="{DynamicResource Ink}" FontFamily="{DynamicResource ReadingFont}" FontSize="18" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="结果">
                            <FlowDocument PagePadding="0" LineHeight="30"/></RichTextBox>
                        <StackPanel x:Name="EmptyResult" VerticalAlignment="Center"><TextBlock x:Name="EmptyTitle" Text="让文字，清楚地抵达。" FontFamily="{DynamicResource ReadingFont}" FontSize="24" Foreground="{DynamicResource InkSecondary}"/><TextBlock x:Name="EmptyHint" Text="输入后按 Enter 执行 · Tab 切换动作" FontSize="13" Foreground="{DynamicResource InkSecondary}" Margin="0,12,0,0" TextWrapping="Wrap"/><Button x:Name="ConfigureButton" Content="配置模型服务" HorizontalAlignment="Left" Margin="0,18,0,0" Click="OnSettings" Foreground="{DynamicResource Accent}" Visibility="Collapsed"/></StackPanel>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="Note" FontSize="12" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button x:Name="RetryCapture" Grid.Column="1" Content="重新截图" Click="OnRetryCapture" Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
