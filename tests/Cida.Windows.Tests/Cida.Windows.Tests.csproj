<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <ProjectReference Include="../../windows/Cida.Desktop/Cida.Desktop.csproj" />
    <Content Include="../../windows/Cida.Desktop/Assets/Fonts/CidaChineseSerif.ttf" Link="fixtures/CidaChineseSerif.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyAccessibilityWorker" AfterTargets="Build">
    <ItemGroup><WorkerFiles Include="../../windows/Cida.Desktop/bin/$(Configuration)/net10.0-windows10.0.19041.0/Cida.exe;../../windows/Cida.Desktop/bin/$(Configuration)/net10.0-windows10.0.19041.0/Cida.runtimeconfig.json;../../windows/Cida.Desktop/bin/$(Configuration)/net10.0-windows10.0.19041.0/Cida.deps.json" /></ItemGroup>
    <Copy SourceFiles="@(WorkerFiles)" DestinationFolder="$(TargetDir)" />
  </Target>
</Project>
